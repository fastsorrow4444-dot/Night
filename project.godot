; Open this file in Godot 4.6.x and press F5.
config_version=5

[application]
config/name="Смена №13"
config/version="0.2.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/description="Две ночные смены, персонаж, одежда, зеркала и фонарик."

[autoload]
Storage="*res://scripts/save/SaveManager.gd"
Game="*res://scripts/game/GameManager.gd"
Audio="*res://scripts/audio/AudioManager.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.036, 1)
anti_aliasing/quality/msaa_3d=1

[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
tasks={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
drop_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
